{
    "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/out",
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.autoClean.run": "onFailed",
    "latex-workshop.latex.clean.subfolder.enabled": true,
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.latex.recipe.default": "Latexmk (pdf)",
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk (Universal)",
            "command": "latexmk",
            "args": [
                "-cd",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-emulate-aux-dir",
                "-pdflatex=pdflatex %O %S",
                "-outdir=%WORKSPACE_FOLDER%/out",
                "-auxdir=%WORKSPACE_FOLDER%/out/aux",
                "%DOC%"
            ]
        },
        {
            "name": "pdflatex (single run)",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%WORKSPACE_FOLDER%/out",
                "%DOC%"
            ]
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": [
                "%WORKSPACE_FOLDER%/out/aux/%DOCFILE%"
            ]
        },
        {
            "name": "latexmk clean",
            "command": "latexmk",
            "args": [
                "-cd",
                "-C",
                "-emulate-aux-dir",
                "-outdir=%WORKSPACE_FOLDER%/out",
                "-auxdir=%WORKSPACE_FOLDER%/out/aux",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "Latexmk (pdf)",
            "tools": [
                "latexmk (Universal)"
            ]
        },
        {
            "name": "pdflatex -> bibtex -> pdflatex x2",
            "tools": [
                "pdflatex (single run)",
                "bibtex",
                "pdflatex (single run)",
                "pdflatex (single run)"
            ]
        },
        {
            "name": "Clean (latexmk)",
            "tools": [
                "latexmk clean"
            ]
        }
    ]
}
